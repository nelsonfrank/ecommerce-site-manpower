# Database connection URL (Default host port is 5433 when running via docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce_db?schema=public"

# JWT configuration
JWT_SECRET="change-me-to-a-secure-random-secret"
JWT_EXPIRES_IN="15m"

# JWT Refresh Token configuration
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Server configuration
PORT=8080
